# ─── Database (Supabase PostgreSQL) ───────────────────────────
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.ujpxksyqkzdfsdsuorof:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.ujpxksyqkzdfsdsuorof:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
# ─── JWT ──────────────────────────────────────────────────────
